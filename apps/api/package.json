{
  "name": "@elcuaderno/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrar.js",
