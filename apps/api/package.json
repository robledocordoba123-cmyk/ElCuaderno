    "test": "jest --runInBand"
  },
  "dependencies": {
    "@elcuaderno/shared": "1.0.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.6",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3"
  }
}
