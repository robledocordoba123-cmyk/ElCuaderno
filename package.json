{
  "name": "elcuaderno",
  "private": true,
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build:shared": "npm run build -w @elcuaderno/shared",
    "dev:api": "npm run dev -w @elcuaderno/api",
    "dev:web": "npm run dev -w @elcuaderno/web",
    "test": "npm test -w @elcuaderno/api",
    "build": "npm run build -w @elcuaderno/shared && npm run build -w @elcuaderno/api && npm run build -w @elcuaderno/web",
    "lint": "eslint .",
    "e2e": "playwright test",
    "test:unit": "npm test -w @elcuaderno/shared"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "type": "module"
}
